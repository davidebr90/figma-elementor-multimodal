<?xml version="1.0"?>
<ruleset name="FEM">
  <file>src</file>
  <file>figma-elementor-multimodal.php</file>
  <rule ref="PSR12">
    <!-- Closely-related security value objects are intentionally co-located. -->
    <exclude name="PSR1.Classes.ClassDeclaration.MultipleClasses"/>
    <!-- WordPress plugin metadata is intentionally the first file comment. -->
    <exclude name="PSR12.Files.FileHeader.SpacingAfterBlock"/>
  </rule>
  <!-- Schema and prepared-query literals remain single-line for readability. -->
  <rule ref="Generic.Files.LineLength">
    <severity>0</severity>
  </rule>
</ruleset>
