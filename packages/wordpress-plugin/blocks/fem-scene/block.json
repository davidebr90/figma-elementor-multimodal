{
  "apiVersion": 3,
  "name": "fem/scene",
  "title": "FEM Scene",
  "category": "design",
  "description": "A safe container for a Figma-derived scene.",
  "textdomain": "figma-elementor-multimodal",
  "editorScript": "file:./editor.js",
  "attributes": {
    "femId": {"type": "string", "default": ""},
    "schemaVersion": {"type": "string", "default": "1.0.0"},
    "sourceHash": {"type": "string", "default": ""}
  },
  "supports": {
    "html": false,
    "customClassName": true,
    "anchor": true,
    "color": {"background": true, "text": true, "link": true},
    "spacing": {"margin": true, "padding": true, "blockGap": true},
    "typography": {"fontSize": true, "lineHeight": true, "textAlign": true},
    "dimensions": {"minHeight": true, "minWidth": true}
  },
  "render": "file:./render.php"
}
